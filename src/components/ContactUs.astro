---
import { API_URL } from "astro:env/client";
---

<div class="container-fluid contact overflow-hidden py-1">
  <div class="container py-5">
    <div class="row g-5 mb-5">
      <div class="col-lg-6 wow fadeInLeft" data-wow-delay="0.1s">
        <div class="sub-style mb-4">
          <h5 class="sub-title text-primary pe-3">Find Us</h5>
        </div>
        {
          /* <!-- <h1 class="display-5 mb-4">We all here to Navigate your legal needs.</h1> -->
                      <!-- <p class="mb-5">Please reach out to use with any quiesion or to schedule a Consultation.</p> --> */
        }
        <div class="d-flex border-bottom mb-4 pb-4">
          <i
            class="fas fa-map-marked-alt fa-2x text-primary bg-light p-3 rounded"
          ></i>
          <div class="ps-3">
            <h5>New Delhi</h5>
            <p>C-131, 1st Floor Lajpat Nagar - 110024</p>
          </div>
        </div>
        <div class="row g-3">
          <div class="col-xl-6">
            <div class="d-flex align-items-start">
              <div
                class="bg-light d-flex align-items-center justify-content-center rounded"
              >
                <i class="fas fa-phone-alt fa-2x text-primary p-3"></i>
              </div>
              <div class="ps-3">
                <h5 class="mb-3">Quick Contact</h5>
                <div class="mb-3">
                  <h6 class="mb-0">Phone:</h6>
                  <a href="tel:011-41540229" class="fs-5 text-primary">
                    011-41540229
                  </a>
                </div>
                <div class="mb-3">
                  <h6 class="mb-0">Email:</h6>
                  <a
                    href="mailto:lexworkss@gmail.com"
                    class="fs-5 text-primary"
                  >
                    lexworkss@gmail.com
                  </a>
                </div>
              </div>
            </div>
          </div>
          <div class="col-xl-6">
            <div class="d-flex align-items-start">
              <div
                class="bg-light d-flex align-items-center justify-content-center rounded"
              >
                <i class="fas fa-clock fa-2x text-primary p-3"></i>
              </div>
              <div class="ps-3">
                <h5 class="mb-3">Office Hours</h5>
                <div class="mb-3">
                  <h6 class="mb-0">Mon - Friday:</h6>
                  <a href="#" class="fs-5 text-primary"> 10.00AM to 07.00PM </a>
                </div>
                <div class="mb-3">
                  <h6 class="mb-0">WeekEnds:</h6>
                  <a href="#" class="fs-5 text-primary"> 12.00PM to 05.00PM </a>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="d-flex align-items-center pt-3">
          <div class="me-3">
            <div
              class="bg-light d-flex align-items-center justify-content-center rounded"
            >
              <i class="fas fa-share fa-2x text-primary p-3"></i>
            </div>
          </div>
          <div class="d-flex gap-2">
            <a class="btn d-flex gap-2 me-1 p-0 linkedinColor" href="#">
              <span>LinkedIn</span>
              <i class="fab fa-linkedin fa-2x align-middle"></i>
            </a>
            <a class="btn d-flex gap-2 mx-1 p-0 instagramColor" href="#">
              <span>Instagram</span>
              <i class="fab fa-instagram-square fa-2x align-middle"></i>
            </a>
            <a
              class="btn d-flex gap-2 mx-1 p-0 whatsappColor"
              href="https://api.whatsapp.com/send?phone=918826872049"
            >
              <span>Whatsapp</span>
              <i class="fab fa-whatsapp-square fa-2x align-middle"></i>
            </a>
          </div>
        </div>
      </div>
      <div class="col-lg-6 wow fadeInRight" data-wow-delay="0.3">
        <div class="sub-style mb-4">
          <h5 class="sub-title text-primary pe-3">Get in Touch</h5>
        </div>
        <p class="mb-3">
          Please reach out to use with any quiesion or to schedule a Consultation.
        </p>
        <form id="contact">
          <div class="row g-4">
            <div class="col-lg-12 col-xl-6 position-relative">
              <div class="form-floating">
                <input
                  type="text"
                  class="form-control"
                  id="name"
                  placeholder="Your Name"
                />
                <label for="name">Your Name</label>
              </div>
              <span id="nameError" class="text-danger small position-absolute"
              ></span>
            </div>
            <div class="col-lg-12 col-xl-6 position-relative">
              <div class="form-floating">
                <input
                  type="email"
                  class="form-control"
                  id="email"
                  placeholder="Your Email"
                />
                <label for="email">Your Email</label>
              </div>
              <span id="emailError" class="text-danger small position-absolute"
              ></span>
            </div>
            <div class="col-lg-12 col-xl-6 position-relative">
              <div class="form-floating">
                <input
                  type="tel"
                  class="form-control"
                  id="phone"
                  placeholder="Phone"
                />
                <label for="phone">Your Phone Number</label>
              </div>
              <span id="phoneError" class="text-danger small position-absolute"
              ></span>
            </div>
            <div class="col-lg-12 col-xl-6 position-relative">
              <div class="form-floating">
                <input
                  type="text"
                  class="form-control"
                  id="project"
                  placeholder="Project"
                />
                <label for="project">Subject</label>
              </div>
              <span
                id="subjectError"
                class="text-danger small position-absolute"></span>
            </div>
            <div class="col-12 position-relative">
              <div class="form-floating">
                <textarea
                  class="form-control"
                  placeholder="Leave a message here"
                  id="message"></textarea>
                <label for="message">Description</label>
              </div>
              <span
                id="descriptionError"
                class="text-danger small position-absolute"></span>
            </div>
            <div class="col-12 position-relative">
              <div class="form-floating">
                <input
                  type="file"
                  class="form-control"
                  id="uploads"
                  placeholder="uploads"
                  accept="application/pdf"
                />
                <label for="uploads">Subject</label>
              </div>
              <span id="imageError" class="text-danger small position-absolute"
              ></span>
            </div>
            <div class="col-12">
              <button class="btn btn-primary w-100 py-3" id="submitButton"> Submit </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ API_URL }}>
  const contact = document.getElementById("contact");
  const nameInput = document.getElementById("name");
  const emailInput = document.getElementById("email");
  const phoneInput = document.getElementById("phone");
  const projectInput = document.getElementById("project");
  const messageInput = document.getElementById("message");
  const submitButton = document.getElementById("submitButton");

  nameInput.addEventListener("keyup", () => {
    document.querySelector("#nameError").innerText = "";
  });

  emailInput.addEventListener("keyup", () => {
    document.querySelector("#emailError").innerText = "";
  });

  phoneInput.addEventListener("keyup", () => {
    document.querySelector("#phoneError").innerText = "";
  });

  projectInput.addEventListener("keyup", () => {
    document.querySelector("#subjectError").innerText = "";
  });

  messageInput.addEventListener("keyup", () => {
    document.querySelector("#descriptionError").innerText = "";
  });

  contact.addEventListener("submit", function (e) {
    e.preventDefault();
    const formData = new FormData();
    const name = nameInput.value.trim();
    const email = emailInput.value.trim();
    const phone = phoneInput.value.trim();
    const project = projectInput.value.trim();
    const message = messageInput.value.trim();
    const imageInput = document.getElementById("uploads");

    // Email regex
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    // Phone regex
    const phoneRegex = /^\+?[0-9]{7,15}$/;

    let isValid = true;

    if (!name) {
      isValid = false;
      const errorMessage = "Name is required.";
      document.querySelector("#nameError").innerText = errorMessage;
    } else {
      document.querySelector("#nameError").innerText = "";
    }
    if (!email || !emailRegex.test(email)) {
      isValid = false;
      const errorMessage = "Valid email is required.";
      document.querySelector("#emailError").innerText = errorMessage;
    } else {
      document.querySelector("#emailError").innerText = "";
    }

    if (!phone || !phoneRegex.test(phone)) {
      isValid = false;
      const errorMessage = "Valid phone number is required.";
      document.querySelector("#phoneError").innerText = errorMessage;
    } else {
      document.querySelector("#phoneError").innerText = "";
    }
    if (!project) {
      isValid = false;
      const errorMessage = "Subject is required.";
      document.querySelector("#subjectError").innerText = errorMessage;
    } else {
      document.querySelector("#subjectError").innerText = "";
    }

    if (!message) {
      isValid = false;
      const errorMessage = "Description is required.";
      document.querySelector("#descriptionError").innerText = errorMessage;
    } else {
      document.querySelector("#descriptionError").innerText = "";
    }

    if (imageInput.files.length > 0) {
      const imageFile = imageInput.files[0];
      const maxSize = 2 * 1024 * 1024; // 2MB
      const allowedTypes = [
        "image/png",
        "image/jpeg",
        "image/gif",
        "application/pdf",
        "application/msword",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/vnd.ms-excel",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      ];

      if (!allowedTypes.includes(imageFile.type)) {
        isValid = false;
        const errorMessage =
          "Invalid file type. Allowed types: Image, PDF, Word, Excel.";
        document.querySelector("#imageError").innerText = errorMessage;
      } else if (imageFile.size > maxSize) {
        isValid = false;
        const errorMessage = "Image size must be less than 2MB.";
        document.querySelector("#imageError").innerText = errorMessage;
      } else {
        formData.append("image", imageFile); // Add the image to FormData
        document.querySelector("#imageError").innerText = "";
      }
    }

    if (!isValid) {
      return;
    } else {
      formData.append("name", name);
      formData.append("email", email);
      formData.append("phone", phone);
      formData.append("subject", project);
      formData.append("description", message);
      submitButton.setAttribute("disabled", "disabled");
      fetch(`${API_URL}/contact`, {
        method: "POST",
        body: formData,
      })
        .then((res) => res.json())
        .then((res) => {
          console.log(res);
          Swal.fire({
            title: "We will get to you soon",
            text: "Successfully submited!",
            icon: "success"
          });

          e.target.reset();
        })
        .catch((error) => {
          console.log(error);
          Swal.fire({
            title: "Not Good job",
            text: "Unable to submit!",
            icon: "error"
          });
        }).finally(() => {
          submitButton.removeAttribute("disabled");
        });
    }
  });
</script>
