---
import { ClientRouter } from "astro:transitions";
const {
  title = "Lex Works | Comprehensive Legal Solutions Across India",
  description = "Discover Lex Works, a law firm offering nationwide legal services with a commitment to resolving complex legal and technical challenges efficiently. Explore our landmark judgments and client-focused approach.",
  jsonLd = null
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- <meta name="generator" content={Astro.generator} /> -->
    <link rel="icon" href="./img/favicon_LW.ico" type="image/x-icon">
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Example: Importing Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Import FontAwesome CSS -->
    <link
      rel="stylesheet"
      href="https://use.fontawesome.com/releases/v5.15.4/css/all.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link href="/styles/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/style.css" />
    <ClientRouter />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HJD6S2PBD2"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-HJD6S2PBD2');
    </script>
    {jsonLd && <script type="application/ld+json" set:html={jsonLd}></script>}
  </head>
  <body>
    <slot />

    <!-- JavaScript Libraries -->
    <script
      is:inline
      src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"
    ></script>
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"
    ></script>
    <script is:inline src="/lib/wow/wow.min.js"></script>
    <script is:inline src="/lib/easing/easing.min.js"></script>
    <script is:inline src="/lib/waypoints/waypoints.min.js"></script>
    <script is:inline src="/lib/counterup/counterup.min.js"></script>
    <script is:inline src="/lib/owlcarousel/owl.carousel.min.js"></script>

    <!-- Template Javascript -->
    <script is:inline src="/js/main.js"></script>
  </body>
</html>
