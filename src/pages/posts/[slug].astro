---
import { stripHtml } from "string-strip-html";
import axios from "axios";
import Header from "../../components/Header";
import Layout from "../../layouts/PostLayout.astro";
import Footer from "../../components/Footer";
import PageHeaderPost from "../../components/PageHeaderPost.astro";
import NewsDetail from "../../components/NewsDetail";
const { slug } = Astro.params;
import { API_URL } from "astro:env/client";
let jsonRes: { title?: ""; description?: "", content?: "" } = {};
try {
  const res = await axios.get(`${API_URL}/posts/${slug}`);
  const json = res.data;
  jsonRes = {
    ...jsonRes,
    ...json.post,
  };

} catch {
  console.log("NO Post");
}

let jsonTagRes = { tags: [] };
try {
  const res = await fetch(`${API_URL}/tags`);
  jsonTagRes = await res.json();
} catch {
  console.log("NO Tags");
}

let jsonAuthorRes = { authors: [] };
try {
  const res = await fetch(`${API_URL}/authors`);
  jsonAuthorRes = await res.json();
} catch {
  console.log("NO Tags");
}
const content = stripHtml(jsonRes?.content || "").result;
---

<Layout title={jsonRes?.title} description={content.slice(0, 200)}>
  <Header />
  <PageHeaderPost pageTitle="Legal Updates" />
  <NewsDetail
    data={jsonRes}
    jsonTagRes={jsonTagRes.tags}
    jsonAuthorRes={jsonAuthorRes.authors}
  />
  <Footer />
</Layout>
