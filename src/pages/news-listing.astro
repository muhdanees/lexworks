---
import Header from "../components/Header";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer";
import NewsListing from "../components/NewsListing";
import { API_URL } from "astro:env/client";
import PageHeaderPost from "../components/PageHeaderPost.astro";
const url = new URL(Astro.request.url);
const page = Number(url.searchParams.get("page")) || 1;
let jsonRes = { posts: [] };
try {
  const res = await fetch(`${API_URL}/posts/latest?page=${page || 1}&limit=5`)
  jsonRes = await res.json();
} catch {
  console.log("NO Posts");
}

let jsonTagRes = { tags: [] };
try {
  const res = await fetch(`${API_URL}/tags`)
  jsonTagRes = await res.json();
} catch {
  console.log("NO Tags");
}
---


<Layout>
  <Header page="news-listing" />
  <PageHeaderPost pageTitle="News & Updates" />
  <NewsListing data={jsonRes} page={page} jsonTagRes={jsonTagRes} />
  <Footer />
</Layout>
