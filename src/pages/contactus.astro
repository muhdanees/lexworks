<Layout title="Contact Lex Works | Schedule a Consultation"
description="Get in touch with Lex Works to discuss your legal needs. Our team is ready to provide personalized legal solutions tailored to your specific requirements."
jsonLd={jsonLd}
>
  <Header page="contatus" />
  <PageHeader pageTitle="Contact Us" />
  <ContactUs />
  <Footer />
  <script is:inline src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</Layout>
