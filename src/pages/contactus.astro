      "addressRegion": "New Delhi",
      "postalCode": "110024",
      "addressCountry": "India"
    },
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "telephone": "011-41540229",
        "contactType": "customer query services",
        "email": "lexworkss@gmail.com",
        "availableLanguage": ["English", "Hindi"]
      }
    ],
    "openingHoursSpecification": [
      {
        "dayOfWeek": "Monday",
