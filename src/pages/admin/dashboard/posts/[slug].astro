---
import SideNavigation from "../../../../components/admin/SideNavigation.astro";
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import EditPost from "../../../../components/admin/EditPost";
import { API_URL } from "astro:env/client";
import "../../../../layouts/AdminBase.css";
const { slug } = Astro.params;
---
<AdminLayout>
  <SideNavigation activeTab="dropdown-pages" />
  <div class="pl-72 py-2 pr-8">
    <EditPost client:only slug={slug} API_URL={API_URL} />
  </div>
</AdminLayout>
